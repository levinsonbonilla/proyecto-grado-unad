# Plantilla de referencia para el .env de producción/demo (VM).
# .env está en .gitignore y NO viaja con git clone — en el VM, después de
# clonar, copiar este archivo a .env y rellenar los valores marcados como
# "CAMBIAR":
#
#   cp docker/env/.env.prod.template .env
#
# Ver README.md y config/packages/doctrine.yaml para más contexto de cada variable.

APP_ENV=prod
APP_SECRET=CAMBIAR-generar-uno-nuevo-con-openssl-rand-hex-16

# SQLite para producción/demo — archivo de datos de la app (distinto del de
# tests, var/test.db). Se crea con: php bin/console doctrine:database:create
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Opcional: sobreescribe la contraseña del superadmin cargado por ProdFixtures
# (--group=prod) sin depender de la que está en preloaded_data/users.yaml.
PROD_SEED_ADMIN_PASSWORD=CAMBIAR-password-nueva

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# SMTP real (o proveedor gratuito tipo Brevo) — vacío no envía correos.
MAILER_DSN=CAMBIAR
MAILER_SENDER_EMAIL=CAMBIAR
MAILER_SENDER_NAME="Proyecto de Grado"

URL_TOKEN_DOWNLOAD=CAMBIAR-token-aleatorio

# Pasarela de pago real (NO el mock de docker/payment-gateway, que es solo para dev).
PAYMENT_GATEWAY_INTERNAL_URL=CAMBIAR
PAYMENT_GATEWAY_SECRET=CAMBIAR

# Dominio de la plataforma y subdominios dinámicos (/comenzar).
PLATFORM_BASE_DOMAIN=multistore.uk
PLATFORM_SCHEME=https
# Con el punto inicial — comparte sesión entre el dominio plataforma y los
# subdominios de tenants.
SESSION_COOKIE_DOMAIN=.multistore.uk

# Vacío en prod (no se usa ahí, ver LocationHandler::resolveIpForLookup()).
DEV_SIMULATED_IP=

# S3 real ya configurado.
AWS_ACCESS_KEY_ID=CAMBIAR
AWS_SECRET_ACCESS_KEY=CAMBIAR
AWS_REGION=CAMBIAR
BUCKET_NAME=CAMBIAR
AWS_ENDPOINT=
CDN_BASE_URL=CAMBIAR
