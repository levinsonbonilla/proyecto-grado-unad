{% extends 'e_commerce/theme_1/base_theme_1.html.twig' %}

{% block title %}
  {{ 'about_title' | trans({}, 'store') | default('About') }}
{% endblock %}

{% block body %}
  <section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('{{ asset('theme_1/images/bg-01.jpg') }}');">
    <h2 class="ltext-105 cl0 txt-center">{{ 'about_title' | trans({}, 'store') | default('About') }}</h2>
  </section>

  <section class="bg0 p-t-75 p-b-120">
    <div class="container">
      {% for section in sections %}
        {% set paragraphs = section.text | replace({"\r": ''}) | split("\n\n") %}
        {% set hasImage = section.image is not empty %}
        {% set imageOnRight = loop.index is odd %}
        <div class="row {{ not loop.last ? 'p-b-100' : '' }}">
          <div class="{{ hasImage ? 'col-md-7 col-lg-8' : 'col-12' }} {{ hasImage and not imageOnRight ? 'order-md-2' : '' }} p-b-30">
            <div class="p-t-7 {{ hasImage ? (imageOnRight ? 'p-r-85 p-r-15-lg p-r-0-md' : 'p-l-85 p-l-15-lg p-l-0-md') : '' }}">
              <h3 class="mtext-111 cl2 p-b-16">{{ section.title }}</h3>

              {% for paragraph in paragraphs %}
                {% if paragraph | trim is not empty %}
                  <p class="stext-113 cl6 p-b-26">{{ paragraph | trim | e | nl2br }}</p>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          {% if hasImage %}
            <div class="col-11 col-md-5 col-lg-4 m-lr-auto p-b-30 {{ not imageOnRight ? 'order-md-1' : '' }}">
              <div class="{{ imageOnRight ? 'how-bor1' : 'how-bor2' }}">
                <div class="hov-img0">
                  <img src="{{ section.image }}" alt="{{ section.title }}" />
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {% else %}
        <p class="stext-113 cl6 txt-center">{{ 'about_empty' | trans({}, 'store') | default('We will share our story here soon.') }}</p>
      {% endfor %}
    </div>
  </section>
{% endblock %}
