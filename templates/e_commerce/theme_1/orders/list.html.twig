{% extends 'e_commerce/theme_1/base_theme_1.html.twig' %}

{% block title %}{{ 'my_orders' | trans({}, 'store') | default('Mis pedidos') }}{% endblock %}

{% block body %}
<div class="bg0 p-t-75 p-b-85">
    <div class="container">
        <div class="bread-crumb flex-w p-b-32">
            <a href="{{ path('store', {_locale: app.request.locale}) }}" class="stext-109 cl8 hov-cl1 trans-04">
                {{ 'home' | trans({}, 'store') | default('Inicio') }}
                <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
            </a>
            <span class="stext-109 cl4">{{ 'my_orders' | trans({}, 'store') | default('Mis pedidos') }}</span>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} p-lr-40 p-tb-20 m-b-20">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {% if orders is not empty %}
        <div class="wrap-table-shopping-cart">
            <table class="table-shopping-cart">
                <tr class="table_head">
                    <th class="column-1">{{ 'order_column' | trans({}, 'store') | default('Pedido') }}</th>
                    <th class="column-2">{{ 'date_column' | trans({}, 'store') | default('Fecha') }}</th>
                    <th class="column-3">{{ 'destination_column' | trans({}, 'store') | default('Destino') }}</th>
                    <th class="column-4">{{ 'total' | trans({}, 'store') | default('Total') }}</th>
                    <th class="column-5">{{ 'status_column' | trans({}, 'store') | default('Estado') }}</th>
                    <th class="column-6"></th>
                </tr>
                {% for order in orders %}
                <tr class="table_row">
                    <td class="column-1">
                        <span class="stext-109 cl6">#{{ order.id | slice(0, 8) | upper }}</span>
                    </td>
                    <td class="column-2">
                        <span class="stext-109 cl6">
                            {% if order.createdAt is not null %}
                                {{ order.createdAt | date('d/m/Y') }}
                            {% endif %}
                        </span>
                    </td>
                    <td class="column-3">
                        <span class="stext-109 cl6">{{ order.countryName }} — {{ order.regionName }}</span>
                    </td>
                    <td class="column-4">
                        <span class="mtext-104 cl2">{{ order.totalAmount | price }}</span>
                    </td>
                    <td class="column-5">
                        <span class="stext-109 cl5">{{ order.statusName }}</span>
                    </td>
                    <td class="column-6">
                        <a href="{{ path('store_orders_detail', {_locale: app.request.locale, id: order.id}) }}"
                           class="stext-101 cl5 hov-cl1 trans-04">
                            {{ 'view_link' | trans({}, 'store') | default('Ver') }} <i class="fa fa-angle-right"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </table>
        </div>
        {% else %}
        <div class="txt-center p-t-50 p-b-80">
            <i class="zmdi zmdi-shopping-basket fs-80 cl6"></i>
            <p class="stext-107 cl6 p-t-20">
                {{ 'no_orders' | trans({}, 'store') | default('Aún no tienes pedidos.') }}
            </p>
            <a href="{{ path('store_shop', {_locale: app.request.locale}) }}"
               class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 m-t-30">
                {{ 'shop_now' | trans({}, 'store') | default('Ver productos') }}
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
