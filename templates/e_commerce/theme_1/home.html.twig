{% extends 'e_commerce/theme_1/base_theme_1.html.twig' %}

{% block title %}{{ 'home' | trans({}, 'store') | default('Home') }}{% endblock %}

{% block stylesheets %}
{{ parent() }}

<link rel="stylesheet" type="text/css" href="{{ asset('theme_1/css/custome_home.css') }}?v=3"/>
{% endblock %}

{% block body %}

{% if slides is not empty %}
<section class="section-slide">
    <div class="wrap-slick1">
        <div class="slick1">
            {% for slide in slides %}
            <div class="item-slick1" style="background-image: url({{ asset(slide.image) }});">
                <div class="container h-full">
                    <div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
                        {% if slide.name %}
                        <div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
                            <span class="ltext-101 cl2 respon2">{{ slide.name }}</span>
                        </div>
                        {% endif %}
                        {% if slide.description %}
                        <div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
                            <h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">{{ slide.description }}</h2>
                        </div>
                        {% endif %}
                        <div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
                            <a href="{{ path('store_shop', {_locale: app.request.locale}) }}"
                               class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04"
                               data-track-event="cta_click"
                               data-track-target="{{ slide.id }}">
                                {{ 'shop_now' | trans({}, 'store') | default('Shop Now') }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{% if categories is not empty %}
<section class="section-categories bgwhite p-t-65 p-b-60">
    <div class="container">
        <div class="section-categories-head p-b-45">
            <span class="section-categories-kicker">{{ 'categories_kicker' | trans({}, 'store') | default('Explora nuestra tienda') }}</span>
            <h3 class="section-categories-title">
                {{ 'categories' | trans({}, 'store') | default('Categorías') }}
            </h3>
        </div>
        <div class="row">
            {% for category in categories %}
            <div class="col-sm-6 col-md-4 col-lg-3 p-b-35">
                <a href="{{ path('store_category', {_locale: app.request.locale, id: category.id}) }}" class="category-card">
                    <div class="category-card-media">
                        {% if category.image %}
                            <img src="{{ asset(category.image) }}" alt="{{ category.name }}" loading="lazy">
                        {% else %}
                            <div class="category-card-placeholder">
                                <i class="fa fa-th-large"></i>
                            </div>
                        {% endif %}
                    </div>
                    <div class="category-card-overlay">
                        <span class="category-card-name">{{ category.name }}</span>
                        <span class="category-card-cta">
                            {{ 'shop_now' | trans({}, 'store') | default('Ver productos') }}
                            <i class="fa fa-long-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{% if products is not empty %}
<section class="bg0 p-t-23 p-b-140">
    <div class="container">
        <div class="p-b-10">
            <h3 class="ltext-103 cl5">
                {{ 'featured_products' | trans({}, 'store') | default('Productos Destacados') }}
            </h3>
        </div>
        <div class="row isotope-grid">
            {% for product in products %}
                {% include 'e_commerce/theme_1/partials/_product_card.html.twig' with {product: product} %}
            {% endfor %}
        </div>
        <div class="flex-c-m flex-w w-full p-t-45">
            <a href="{{ path('store_shop', {_locale: app.request.locale}) }}"
               class="flex-c-m stext-101 cl5 size-103 bg2 bor1 hov-btn1 p-lr-15 trans-04">
                {{ 'view_all' | trans({}, 'store') | default('Ver todos') }}
            </a>
        </div>
    </div>
</section>
{% endif %}

{% endblock %}
