{% extends 'e_commerce/theme_1/base_theme_1.html.twig' %}

{% block title %}{{ 'favorites' | trans({}, 'store') | default('Favoritos') }}{% endblock %}

{% block body %}
<div class="bg0 p-t-75 p-b-85">
    <div class="container">
        <div class="bread-crumb flex-w p-b-32">
            <a href="{{ path('store', {_locale: app.request.locale}) }}" class="stext-109 cl8 hov-cl1 trans-04">
                {{ 'home' | trans({}, 'store') | default('Inicio') }}
                <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
            </a>
            <span class="stext-109 cl4">{{ 'favorites' | trans({}, 'store') | default('Favoritos') }}</span>
        </div>

        {% if products is not empty %}
        <div class="row isotope-grid">
            {% for product in products %}

                {% include 'e_commerce/theme_1/partials/_product_card.html.twig' with {product: product|merge({isFavorite: true})} %}
            {% endfor %}
        </div>
        {% else %}
        <div class="txt-center p-t-50 p-b-80">
            <i class="zmdi zmdi-favorite-outline fs-80 cl6"></i>
            <p class="stext-107 cl6 p-t-20">
                {{ 'no_favorites' | trans({}, 'store') | default('Aún no tienes productos favoritos.') }}
            </p>
            <a href="{{ path('store_shop', {_locale: app.request.locale}) }}"
               class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 m-t-30">
                {{ 'explore_products' | trans({}, 'store') | default('Explorar productos') }}
            </a>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>

document.addEventListener('favorite:toggled', function (e) {
    if (e.detail.isFavorite) {
        return;
    }
    e.target.closest('.col-sm-6')?.remove();
});
</script>
{% endblock %}
