<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <script>

      window.__CURRENCY__ = {{ currentCurrency() | json_encode | raw }};
      window.formatCurrencyAmount = function (raw) {
        var c = window.__CURRENCY__ || { symbol: '$', decimalPlaces: 2, thousandsSeparator: ',', decimalSeparator: '.' };
        var divisor = Math.pow(10, c.decimalPlaces);
        var value = (Number(raw) || 0) / divisor;
        var parts = value.toFixed(c.decimalPlaces).split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, c.thousandsSeparator);
        return c.symbol + (parts.length > 1 ? parts.join(c.decimalSeparator) : parts[0]);
      };
    </script>
    <title>
      {% block title %}Welcome!{% endblock %}
    </title>
    {% block stylesheets %}
      <link rel="icon" type="image/png" href="{{ asset('theme_1/images/icons/favicon.png') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/bootstrap/css/bootstrap.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/fonts/font-awesome-4.7.0/css/font-awesome.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/fonts/iconic/css/material-design-iconic-font.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/fonts/linearicons-v1.0.0/icon-font.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/animate/animate.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/css-hamburgers/hamburgers.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/animsition/css/animsition.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/select2/select2.min.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/daterangepicker/daterangepicker.css') }}" />
      <!-- =============================================================================================== -->
      <link rel="stylesheet" type="text/css" href="{{ asset('theme_1/vendor/slick/slick.css') }}" />
