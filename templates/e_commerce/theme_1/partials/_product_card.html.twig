

<div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item">
    <div class="block2">
        <div class="block2-pic hov-img0">
            {% if product.image %}
                <img class="img-fluid" src="{{ asset(product.image) }}" alt="{{ product.name }}">
            {% else %}
                <img class="img-fluid" src="{{ asset('theme_1/images/product-placeholder.jpg') }}" alt="{{ product.name }}">
            {% endif %}
            <button type="button"
                    onclick="openModal('{{ product.id }}')"
                    class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
                {{ 'quick_view' | trans({}, 'store') | default('Quick View') }}
            </button>
        </div>
        <div class="block2-txt flex-w flex-t p-t-14">
            <div class="block2-txt-child1 flex-col-l">
                <a href="{{ path('store_product', {_locale: app.request.locale, id: product.id}) }}"
                   class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6"
                   data-track-event="product_click"
                   data-track-target="{{ product.id }}">
                    {{ product.name }}
                </a>
                <span class="stext-105 cl3">
                    {{ product.publicPrice | price }}
                </span>

                {% if product.stock is not null %}
                    <span class="stext-109 cl6 p-t-2">
                        {{ 'stock_available' | trans({'%count%': product.stock}, 'store') | default(product.stock ~ ' disponibles') }}
                    </span>
                {% endif %}
            </div>
            <div class="block2-txt-child2 flex-r p-t-3">

                <a href="#" class="btn-addwish-b2 dis-block pos-relative js-addwish-b2{{ (product.isFavorite ?? false) ? ' js-addedwish-b2' : '' }}" data-product-id="{{ product.id }}">
                    <img class="icon-heart1 dis-block trans-04" src="{{ asset('theme_1/images/icons/icon-heart-01.png') }}" alt="ICON">
                    <img class="icon-heart2 dis-block trans-04 ab-t-l" src="{{ asset('theme_1/images/icons/icon-heart-02.png') }}" alt="ICON">
                </a>
            </div>
        </div>
    </div>
</div>
