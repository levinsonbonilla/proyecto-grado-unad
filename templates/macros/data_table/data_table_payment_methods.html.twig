{% macro data_table_payment_methods() %}
    <script>
        var ajaxPath = "{{ path('dashboard_products_payment_methods_list') }}";
        var pathEdit = "{{ path('dashboard_products_payment_methods_edit', {'id': 'CHANGE'}) }}";
        var pathDelete = "{{ path('dashboard_products_payment_methods_delete', {'id': 'CHANGE'}) }}";

        var columnDefs = [
            { data: "active", render: function(data) { return data ? "<span class='label label-success'>{{ 'yes'|trans({}, 'messages') }}</span>" : "<span class='label label-danger'>{{ 'no'|trans({}, 'messages') }}</span>"; }, targets: 0 },
            {
                data: null,
                render: function(data, type, row) {
                    return `<li class="text-center" style="list-style-type: none;">
                        <div class="dropdown">
                            <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown">
                                <i class="fa fa-bars fa-1x pull-center"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-start">
                                <li>
                                    <a class="dropdown-item" href="${pathEdit.replace('CHANGE', row.id)}">
                                        <i class="fa fa-pencil-square-o"></i> {{ 'edit'|trans({}, 'users') }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-warning" href="#" onclick="openPaymentMethodStatusModal('${row.id}'); return false;">
                                        <i class="fa fa-refresh"></i> {{ 'change_status'|trans({}, 'messages') }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>`;
                },
                targets: 1
            },
            { data: "name", targets: 2 },
            { data: "id", visible: false, targets: 3 },
        ];

        var pendingPaymentMethodId = null;

        function openPaymentMethodStatusModal(id) {
            pendingPaymentMethodId = id;
            $('#paymentMethodStatusModalError').hide();
            $('#paymentMethodStatusModal').modal('show');
        }

        $('#paymentMethodStatusModalConfirmBtn').on('click', function() {
            if (!pendingPaymentMethodId) return;
            var id = pendingPaymentMethodId;
            pendingPaymentMethodId = null;

            fetch(pathDelete.replace('CHANGE', id), {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    $('#paymentMethodStatusModal').modal('hide');
                    $('#datatable-payment-methods').DataTable().ajax.reload(null, false);
                } else {
                    $('#paymentMethodStatusModalError').show();
                }
            })
            .catch(function() { $('#paymentMethodStatusModalError').show(); });
        });
    </script>
{% endmacro %}
