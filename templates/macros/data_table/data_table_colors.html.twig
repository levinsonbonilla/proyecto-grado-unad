{% macro data_table_colors() %}
    <script>
        var ajaxPath = "{{ path('dashboard_products_colors_list') }}";
        var pathEdit = "{{ path('dashboard_products_colors_edit', {'id': 'CHANGE'}) }}";
        var pathToggleStatus = "{{ path('dashboard_products_colors_toggle_status', {'id': 'CHANGE'}) }}";

        var columnDefs = [
            { data: "active", render: function(data) { return data ? "<span class='label label-success'>{{ 'yes'|trans({}, 'users') }}</span>" :  "<span class='label label-danger'>{{ 'no'|trans({}, 'users') }}</span>"; }, targets: 0 },
            {
                data: null,
                render: function(data, type, row) {
                    return `<li class="text-center" style="list-style-type: none; ">
                        <div class="dropdown">
                            <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-bars fa-1x pull-center"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="dropdownMenuButton">
                                <li>
                                    <a class="dropdown-item" href="${pathEdit.replace('CHANGE', row.id)}">
                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i> {{ 'edit'|trans({}, 'users') }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-warning" href="#" onclick="openColorStatusModal('${row.id}'); return false;">
                                        <i class="fa fa-refresh" aria-hidden="true"></i> {{ 'change_status'|trans({}, 'messages') }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>`;
                },
                targets: 1
            },
            {
                data: "hexCode",
                targets: 2,
                render: function (data) {
                    return `<span style="display:inline-block;width:16px;height:16px;border-radius:50%;border:1px solid #ccc;background:${data};vertical-align:middle;margin-right:6px;"></span>${data}`;
                }
            },
            { data: "name", targets: 3 },
            { data: "id", visible: false, targets: 4 },
        ];

        var pendingColorStatusId = null;

        function openColorStatusModal(id) {
            pendingColorStatusId = id;
            $('#colorStatusModalError').hide();
            $('#colorStatusModal').modal('show');
        }

        $('#colorStatusModalConfirmBtn').on('click', function() {
            if (!pendingColorStatusId) return;
            var id = pendingColorStatusId;
            pendingColorStatusId = null;
            $('#colorStatusModalError').hide();

            fetch(pathToggleStatus.replace('CHANGE', id), {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    $('#colorStatusModal').modal('hide');
                    $('#datatable-colors-loading').show();
                    $('#datatable-colors').DataTable().ajax.reload(function() {
                        $('#datatable-colors-loading').hide();
                    }, false);
                } else {
                    $('#colorStatusModalError').show();
                }
            })
            .catch(function() {
                $('#colorStatusModalError').show();
            });
        });
    </script>
{% endmacro %}
