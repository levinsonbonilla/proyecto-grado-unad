{% macro data_table_about_sections() %}
    <script>

        var ajaxPath = "{{ path('dashboard_configurations_about_list') }}";
        var pathEdit = "{{ path('dashboard_configurations_about_edit', {'id': 'CHANGE'}) }}";
        var pathToggle = "{{ path('dashboard_configurations_about_toggle_status', {'id': 'CHANGE'}) }}";

        var columnDefs = [
            { data: "active", render: function(data) { return data ? "<span class='label label-success'>{{ 'yes'|trans({}, 'about_sections') }}</span>" :  "<span class='label label-danger'>{{ 'no'|trans({}, 'about_sections') }}</span>"; }, targets: 0 },
            {
                data: null,
                render: function(data, type, row) {
                    return `<li class="text-center" style="list-style-type: none; ">
                        <div class="dropdown">
                            <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-bars fa-1x pull-center"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="dropdownMenuButton">
                                <li>
                                    <a class="dropdown-item" href="${pathEdit.replace('CHANGE', row.id)}">
                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i> {{ 'edit'|trans({}, 'users') }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-warning" href="#" onclick="openStatusModal('${row.id}'); return false;">
                                        <i class="fa fa-refresh" aria-hidden="true"></i> {{ 'change_status'|trans({}, 'about_sections') }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>`;
                },
                targets: 1
            },
            { data: "title", targets: 2 },
            { data: "position", targets: 3 },
            { data: "id", visible: false, targets: 4 },
        ];

        var pendingStatusSectionId = null;

        function openStatusModal(id) {
            pendingStatusSectionId = id;
            $('#aboutSectionStatusModalError').hide();
            $('#aboutSectionStatusModal').modal('show');
        }

        $('#aboutSectionStatusModalConfirmBtn').on('click', function() {
            if (!pendingStatusSectionId) return;
            var id = pendingStatusSectionId;
            pendingStatusSectionId = null;
            $('#aboutSectionStatusModalError').hide();

            fetch(pathToggle.replace('CHANGE', id), {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    $('#aboutSectionStatusModal').modal('hide');
                    $('#datatable-about-sections-loading').show();
                    $('#datatable-about-sections').DataTable().ajax.reload(function() {
                        $('#datatable-about-sections-loading').hide();
                    }, false);
                } else {
                    $('#aboutSectionStatusModalError').show();
                }
            })
            .catch(function() {
                $('#aboutSectionStatusModalError').show();
            });
        });

    </script>
{% endmacro %}
