{% macro data_table_medidas() %}
    <script>
        var ajaxPath = "{{ path('dashboard_products_medidas_list') }}";
        var pathEdit = "{{ path('dashboard_products_medidas_edit', {'id': 'CHANGE'}) }}";
        var pathToggleStatus = "{{ path('dashboard_products_medidas_toggle_status', {'id': 'CHANGE'}) }}";

        var columnDefs = [
            { data: "active", render: function(data) { return data ? "<span class='label label-success'>{{ 'yes'|trans({}, 'users') }}</span>" :  "<span class='label label-danger'>{{ 'no'|trans({}, 'users') }}</span>"; }, targets: 0 },
            {
                data: null,
                render: function(data, type, row) {
                    return `<li class="text-center" style="list-style-type: none; ">
                        <div class="dropdown">
                            <button class="btn btn-default dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fa fa-bars fa-1x pull-center"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="dropdownMenuButton">
                                <li>
                                    <a class="dropdown-item" href="${pathEdit.replace('CHANGE', row.id)}">
                                        <i class="fa fa-pencil-square-o" aria-hidden="true"></i> {{ 'edit'|trans({}, 'users') }}
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-warning" href="#" onclick="openMedidaStatusModal('${row.id}'); return false;">
                                        <i class="fa fa-refresh" aria-hidden="true"></i> {{ 'change_status'|trans({}, 'messages') }}
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>`;
                },
                targets: 1
            },
            { data: "name", targets: 2 },
            { data: "id", visible: false, targets: 3 },
        ];

        var pendingMedidaStatusId = null;

        function openMedidaStatusModal(id) {
            pendingMedidaStatusId = id;
            $('#medidaStatusModalError').hide();
            $('#medidaStatusModal').modal('show');
        }

        $('#medidaStatusModalConfirmBtn').on('click', function() {
            if (!pendingMedidaStatusId) return;
            var id = pendingMedidaStatusId;
            pendingMedidaStatusId = null;
            $('#medidaStatusModalError').hide();

            fetch(pathToggleStatus.replace('CHANGE', id), {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    $('#medidaStatusModal').modal('hide');
                    $('#datatable-medidas-loading').show();
                    $('#datatable-medidas').DataTable().ajax.reload(function() {
                        $('#datatable-medidas-loading').hide();
                    }, false);
                } else {
                    $('#medidaStatusModalError').show();
                }
            })
            .catch(function() {
                $('#medidaStatusModalError').show();
            });
        });
    </script>
{% endmacro %}
