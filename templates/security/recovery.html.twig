{% extends 'base.html.twig' %}
{% import 'macros/dashboard.html.twig' as macros %}
{% import 'macros/alert.html.twig' as alert %}

{% block title %}
	{{ 'name'|currentTenant }}
{% endblock %}

{% block body %}
	<body class="login">
		<div>
			<div class="login_wrapper">
				<div class="animate">
					{{ alert.alert_success() }}
					{{ alert.alert_error() }}

					<section class="login_content">
						{{ form_start(form, {'attr': {'id': 'recovery',"method":"POST" }}) }}
						<h1>{{ 'reset_access'|trans({}, 'login') }}</h1>
						<div class="form-group">
							{{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'email_label'|trans({}, 'login') ~ "*" }}) }}
							{{ form_errors(form.email,{'attr':{'class': 'parsley-required'} }) }}
						</div>
						<div>
							<button type="submit" id="btn_register" class="btn btn-default">{{ 'accept_button'|trans({}, 'login') }}</button>
						</div>
						<div class="clearfix"></div>

						<div class="separator">
							<p class="change_link">
								{{ 'already_a_member_question'|trans({}, 'login') }}
								<a href="{{ path('security_login') }}" class="to_register">{{ 'log_in_action'|trans({}, 'login') }}</a>
							</p>

							<div class="clearfix"></div>
							<br/>

							{{ macros.term_and_conditions() }}
						</div>
						{{ form_end(form) }}
					</section>
				</div>
			</div>
		</div>
	</body>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			$('#recovery').parsley();
		});
	</script>
{% endblock %}
