{% block menu %}
	<div class="col-md-3 left_col">
		<div class="left_col scroll-view">
			<div class="navbar nav_title" style="border: 0;">
				<a href="{{ path('dashboard') }}" class="site_title">
					<i class="fa fa-shopping-basket"></i>
					<span>{{ "name" | currentTenant }}</span>
				</a>
			</div>

			<div class="clearfix"></div>

			<!-- menu profile quick info -->
			<div class="profile clearfix">
				<div class="profile_pic">
					<img src="{{ asset(app.user.getProfilePicture() | default('') ) }}" alt="..." class="img-circle profile_img">
				</div>
				<div class="profile_info">
					<span>{{ 'welcome'|trans({}, 'dashboard') }}</span>
					<h2>{{ app.user.getFullName() | default('') }}</h2>
				</div>
			</div>
			<!-- /menu profile quick info -->

			<br/>

			<!-- sidebar menu -->
			<div id="sidebar-menu" class="main_menu_side hidden-print main_menu">
				<div class="menu_section {{ ('users' | isCurrentRoute ? 'active' : '') }}">
					<h3>{{ 'general'|trans({}, 'dashboard') }}</h3>

					<ul class="nav side-menu">
						<li class="{{ 'users,users_profile' | isCurrentRoute ? 'active' : '' }}">
							<a>
								<i class="fa fa-user"></i>
								{{ 'users'|trans({}, 'dashboard') }}
								<span class="fa fa-chevron-down"></span>
							</a>
							<ul class="nav child_menu" style="display: {{ 'users' | isCurrentRoute ? 'block' : 'none' }};">
								<li class="{{ 'users' | isCurrentRoute ? 'current-page' : '' }}">
									<a href="{{ path('dashboard_users') }}">{{ 'users'|trans({}, 'dashboard') }}</a>
								</li>
								<li class="{{ 'users_profile' | isCurrentRoute ? 'current-page' : '' }}">
									<a href="{{ path('dashboard_users_profile') }}">{{ 'profile'|trans({}, 'dashboard') }}</a>
								</li>
							</ul>
						</li>
					</ul>

					<ul class="nav side-menu">
						<li class="{{ 'configurations' | isCurrentRoute ? 'active' : '' }}">
							<a>
								<i class="fa fa-cog"></i>
								{{ 'settings'|trans({}, 'dashboard') }}
								<span class="fa fa-chevron-down"></span>
							</a>

							<ul class="nav child_menu" style="display: {{ 'configurations_domains,slides' | isCurrentRoute ? 'block' : 'none' }};">
								<li class="{{ 'configurations_domains' | isCurrentRoute ? 'current-page' : '' }}">
									<a href="{{ path('dashboard_configurations_domains') }}">{{ 'domains'|trans({}, 'dashboard') }}</a>
								</li>
								<li class="{{ 'slides' | isCurrentRoute ? 'current-page' : '' }}">
									<a href="{{ path('dashboard_configurations_slides') }}">{{ 'slides'|trans({}, 'dashboard') }}</a>
								</li>
							</ul>
						</li>
					</ul>

					<ul class="nav side-menu">
						<li class="{{ 'products,sales,statistics_products' | isCurrentRoute ? 'active' : '' }}">
							<a>
								<i class="fa fa-cubes"></i>
								{{ 'products'|trans({}, 'dashboard') }}
								<span class="fa fa-chevron-down"></span>
							</a>
							<ul class="nav child_menu" style="display: {{ 'manager,categories,products_colors,medidas,payment_methods,sales,statistics_products' | isCurrentRoute ? 'block' : 'none' }};">

								<li class="{{ 'manager,categories,products_colors,medidas,payment_methods' | isCurrentRoute ? 'active' : '' }}">
									<a>
										<i class="fa fa-cog"></i>
										{{ 'products_config_section'|trans({}, 'dashboard') }}
										<span class="fa fa-chevron-down"></span>
									</a>
									<ul class="nav child_menu" style="display: {{ 'manager,categories,products_colors,medidas,payment_methods' | isCurrentRoute ? 'block' : 'none' }};">
										<li class="{{ 'manager' | isCurrentRoute ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_products_manager') }}">{{ 'products'|trans({}, 'dashboard') }}</a>
										</li>
										<li class="{{ 'categories' | isCurrentRoute ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_products_categories') }}">{{ 'categories'|trans({}, 'dashboard') }}</a>
										</li>
										<li class="{{ 'products_colors' | isCurrentRoute ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_products_colors') }}">{{ 'colors'|trans({}, 'dashboard') }}</a>
										</li>
										<li class="{{ 'medidas' | isCurrentRoute ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_products_medidas') }}">{{ 'medidas'|trans({}, 'dashboard') }}</a>
										</li>
										<li class="{{ 'payment_methods' | isCurrentRoute ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_products_payment_methods') }}">{{ 'payment_methods'|trans({}, 'dashboard') }}</a>
										</li>
									</ul>
								</li>

								<li class="{{ 'sales,statistics_products' | isCurrentRoute ? 'active' : '' }}">
									<a>
										<i class="fa fa-line-chart"></i>
										{{ 'products_management_section'|trans({}, 'dashboard') }}
										<span class="fa fa-chevron-down"></span>
									</a>
									<ul class="nav child_menu" style="display: {{ 'sales,statistics_products' | isCurrentRoute ? 'block' : 'none' }};">
										<li class="{{ 'sales' | isCurrentRoute ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_sales_orders', {_locale: app.request.locale}) }}">
												<i class="fa fa-shopping-cart"></i>
												{{ 'sales'|trans({}, 'dashboard') }}
											</a>
										</li>
										<li class="{{ (app.request.attributes.get('_route') starts with 'dashboard_statistics_products') ? 'current-page' : '' }}">
											<a href="{{ path('dashboard_statistics_products', {_locale: app.request.locale}) }}">
												<i class="fa fa-shopping-cart"></i>
												{{ 'product_stats_title'|trans({}, 'statistics') }}
											</a>
										</li>
									</ul>
								</li>
							</ul>
						</li>
					</ul>
				</div>

				{% if app.user != null and is_granted('ROLE_SUPER_ADMIN') %}
					<div class="menu_section">
						<h3>{{ 'tenant_management'|trans({}, 'dashboard') }}</h3>
						<ul class="nav side-menu">
							<li class="{{ 'tenants' | isCurrentRoute ? 'active' : '' }}">
								<a>
									<i class="fa fa-black-tie"></i>
									{{ 'business'|trans({}, 'dashboard') }}
									<span class="fa fa-chevron-down"></span>
								</a>
								<ul class="nav child_menu" style="display: {{ 'tenants' | isCurrentRoute ? 'block' : 'none' }};">
									<li class="{{ 'tenants' | isCurrentRoute ? 'current-page' : '' }}">
										<a href="{{path('dashboard_tenants')}}">{{ 'tenants'|trans({}, 'dashboard') }}</a>
									</li>
								</ul>
							</li>
						</ul>
					</div>
				{% endif %}

			</div>
			<!-- /sidebar menu -->

			<!-- /menu footer buttons -->
			<div class="sidebar-footer hidden-small">
				<a data-toggle="tooltip" data-placement="top" title="{{ 'settings'|trans({}, 'dashboard') }}">
					<span class="glyphicon glyphicon-cog" aria-hidden="true"></span>
				</a>
				<a data-toggle="tooltip" data-placement="top" title="{{ 'fullscreen'|trans({}, 'dashboard') }}">
					<span class="glyphicon glyphicon-fullscreen" aria-hidden="true"></span>
				</a>
				<a data-toggle="tooltip" data-placement="top" title="{{ 'lock'|trans({}, 'dashboard') }}">
					<span class="glyphicon glyphicon-eye-close" aria-hidden="true"></span>
				</a>
				<a data-toggle="tooltip" data-placement="top" title="{{ 'logout'|trans() }}" href="{{ path('security_logout') }}">
					<span class="glyphicon glyphicon-off" aria-hidden="true"></span>
				</a>
			</div>
			<!-- /menu footer buttons -->
		</div>
	</div>
{% endblock  %}
