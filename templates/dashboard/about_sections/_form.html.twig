{% import 'macros/preview_image.html.twig' as image %}
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>{{ 'info'|trans({}, 'about_sections') }}</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('dashboard') }}" class="dropdown">
                            <i class="fa fa-home" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('dashboard_configurations_about') }}" class="dropdown">
                            <i class="fa fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">

                {{ form_start(form, {'attr': {'id': 'about_section_form', 'class': 'form-horizontal form-label-left', 'enctype': 'multipart/form-data'}}) }}

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="about_sections_image">
                        {{ 'image'|trans({}, 'about_sections') }}
                    </label>
                    {{ image.general(form, 'about_sections', section.image | default('#')) }}
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="about_sections_title">{{ 'title'|trans({}, 'about_sections') }}
                        <span class="required">*</span>
                    </label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.title, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'required': 'required', 'maxlength': 255}}) }}
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="about_sections_text">{{ 'text'|trans({}, 'about_sections') }}
                        <span class="required">*</span>
                    </label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.text, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'required': 'required', 'rows': 8}}) }}
                        <span class="help-block">{{ 'text_help'|trans({}, 'about_sections') }}</span>
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="about_sections_position">{{ 'position'|trans({}, 'about_sections') }}</label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.position, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                        <span class="help-block">{{ 'position_help'|trans({}, 'about_sections') }}</span>
                    </div>
                </div>

                <div class="ln_solid"></div>
                <div class="form-group">
                    <div class="col-md-6 col-md-offset-3">
                        <a href="{{ path('dashboard_configurations_about') }}" class="btn btn-primary">{{ 'cancel'|trans() }}</a>
                        <button id="send" type="submit" class="btn btn-success">{{ 'submit'|trans() }}</button>
                    </div>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>
