<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8"/>
		<script>

			window.__CURRENCY__ = {{ currentCurrency() | json_encode | raw }};
			window.formatCurrencyAmount = function (raw) {
				var c = window.__CURRENCY__ || { symbol: '$', decimalPlaces: 2, thousandsSeparator: ',', decimalSeparator: '.' };
				var divisor = Math.pow(10, c.decimalPlaces);
				var value = (Number(raw) || 0) / divisor;
				var parts = value.toFixed(c.decimalPlaces).split('.');
				parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, c.thousandsSeparator);
				return c.symbol + (parts.length > 1 ? parts.join(c.decimalSeparator) : parts[0]);
			};
		</script>
		<title>
			{% block title %}
				Welcome!
			{% endblock %}
		</title>
		<link
