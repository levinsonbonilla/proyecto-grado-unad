{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/alert.html.twig' as alert %}

{% block title %}{{ 'sent_title'|trans({}, 'help_messages') }}{% endblock %}

{% block body %}
    <div class="right_col" role="main">
        <div class="">
            <div class="page-title">
                {{ alert.alert_success() }}
                {{ alert.alert_error() }}
                <div class="title_left">
                    <h3><i class="fa fa-paper-plane"></i> {{ 'sent_title'|trans({}, 'help_messages') }}</h3>
                </div>
                <div class="title_right">
                    <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                        <div class="input-group">
                            <a href="{{ path('dashboard_messages_compose') }}" class="btn btn-primary form-control">
                                <i class="fa fa-pencil"></i>&nbsp;&nbsp;{{ 'new_message'|trans({}, 'help_messages') }}
                            </a>
                            <span class="input-group-btn">
                                <a href="{{ path('dashboard_messages') }}" class="btn btn-default" title="{{ 'inbox_tooltip'|trans({}, 'help_messages') }}">
                                    <i class="fa fa-inbox"></i>
                                </a>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>{{ 'sent_panel_title'|trans({}, 'help_messages') }}</h2>
                            <ul class="nav navbar-right panel_toolbox">
                                <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <table id="datatable-sent" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>{{ 'to_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'subject_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'message_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'read_label'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'date_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'actions'|trans({}, 'messages') }}</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    $(document).ready(function () {
        var i18n = {
            noSubject: '{{ 'no_subject'|trans({}, 'help_messages')|e('js') }}',
            read: '{{ 'read_label'|trans({}, 'help_messages')|e('js') }}',
            unread: '{{ 'unread_label'|trans({}, 'help_messages')|e('js') }}',
            view: '{{ 'view'|trans({}, 'help_messages')|e('js') }}'
        };

        $('#datatable-sent').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '{{ path('dashboard_messages_sent_list') }}',
                type: 'POST'
            },
            columns: [
                {
                    data: null,
                    render: function (row) {
                        return (row.toUserName || '') + ' ' + (row.toUserLastName || '');
                    }
                },
                {
                    data: 'subject',
                    render: function (data) {
                        return data ? data : '<span class="text-muted">' + i18n.noSubject + '</span>';
                    }
                },
                {
                    data: 'message',
                    render: function (data) {
                        return data ? data.substring(0, 80) + (data.length > 80 ? '...' : '') : '';
                    }
                },
                {
                    data: 'isRead',
                    render: function (data) {
                        return data
                            ? '<span class="label label-success"><i class="fa fa-check"></i> ' + i18n.read + '</span>'
                            : '<span class="label label-warning">' + i18n.unread + '</span>';
                    }
                },
                { data: 'createdAt' },
                {
                    data: 'id',
                    render: function (id) {
                        return '<a href="{{ path('dashboard_messages') }}/' + id + '" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> ' + i18n.view + '</a>';
                    }
                }
            ],
            order: [[4, 'desc']],
            language: {
                lengthMenu: "{{ 'datatable.lengthMenu'|trans({}, 'dashboard') }}",
                zeroRecords: "{{ 'datatable.zeroRecords'|trans({}, 'dashboard') }}",
                info: "{{ 'datatable.info'|trans({}, 'dashboard') }}",
                infoEmpty: "{{ 'datatable.infoEmpty'|trans({}, 'dashboard') }}",
                emptyTable: "{{ 'datatable.emptyTable'|trans({}, 'dashboard') }}",
                loadingRecords: "{{ 'datatable.loadingRecords'|trans({}, 'dashboard') }}",
                processing: "{{ 'datatable.processing'|trans({}, 'dashboard') }}",
                search: "{{ 'datatable.search'|trans({}, 'dashboard') }}",
                infoFiltered: "{{ 'datatable.infoFiltered'|trans({}, 'dashboard') }}",
                paginate: {
                    next: "{{ 'datatable.paginate.next'|trans({}, 'dashboard') }}",
                    previous: "{{ 'datatable.paginate.previous'|trans({}, 'dashboard') }}"
                }
            }
        });
    });
    </script>
{% endblock %}
