{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/alert.html.twig' as alert %}

{% block title %}{{ 'title'|trans({}, 'help_messages') }}{% endblock %}

{% block body %}
    <div class="right_col" role="main">
        <div class="">
            <div class="page-title">
                {{ alert.alert_success() }}
                {{ alert.alert_error() }}
                <div class="title_left">
                    <h3><i class="fa fa-envelope-o"></i> {{ 'title'|trans({}, 'help_messages') }}</h3>
                </div>
                <div class="title_right">
                    <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                        <button type="button" class="btn btn-primary form-control" id="btnNewMessageInbox">
                            <i class="fa fa-pencil"></i>&nbsp;&nbsp;{{ 'new_message'|trans({}, 'help_messages') }}
                        </button>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="row" style="margin-bottom: 10px;">
                <div class="col-md-12">
                    <div class="x_panel">
                        <div class="x_content" style="padding: 10px 15px;">
                            <div class="row">
                                <div class="col-md-4 col-sm-6">
                                    <label class="control-label">{{ 'filter_by_sender'|trans({}, 'help_messages') }}</label>
                                    <select id="filterUserId" class="form-control">
                                        <option value="">{{ 'all_option'|trans({}, 'help_messages') }}</option>
                                        {% for sender in senders %}
                                            <option value="{{ sender.id }}">{{ sender.name }} {{ sender.lastName }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="control-label">{{ 'filter_by_status'|trans({}, 'help_messages') }}</label>
                                    <select id="filterIsRead" class="form-control">
                                        <option value="">{{ 'all_option'|trans({}, 'help_messages') }}</option>
                                        <option value="0">{{ 'unread'|trans({}, 'help_messages') }}</option>
                                        <option value="1">{{ 'read_status'|trans({}, 'help_messages') }}</option>
                                    </select>
                                </div>
                                <div class="col-md-2 col-sm-12" style="padding-top: 25px;">
                                    <button type="button" id="btnApplyFilter" class="btn btn-default">
                                        <i class="fa fa-filter"></i> {{ 'apply_filter'|trans({}, 'help_messages') }}
                                    </button>
                                    <button type="button" id="btnClearFilter" class="btn btn-link">
                                        {{ 'clear_filter'|trans({}, 'help_messages') }}
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>{{ 'received_messages'|trans({}, 'help_messages') }}</h2>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <table id="datatable-inbox" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width:90px;">{{ 'status_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'from_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'subject_column'|trans({}, 'help_messages') }}</th>
                                        <th>{{ 'message_column'|trans({}, 'help_messages') }}</th>
                                        <th style="width:150px;">{{ 'date_column'|trans({}, 'help_messages') }}</th>
                                        <th style="width:130px;">{{ 'actions'|trans({}, 'messages') }}</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    $(document).ready(function () {
        var activeFilters = { filterUserId: '', filterIsRead: '' };
        var i18n = {
            read: '{{ 'read_label'|trans({}, 'help_messages')|e('js') }}',
            new: '{{ 'new_label'|trans({}, 'help_messages')|e('js') }}',
            markAsUnread: '{{ 'mark_as_unread'|trans({}, 'help_messages')|e('js') }}',
            markAsRead: '{{ 'mark_as_read'|trans({}, 'help_messages')|e('js') }}',
            noSubject: '{{ 'no_subject'|trans({}, 'help_messages')|e('js') }}',
            view: '{{ 'view'|trans({}, 'help_messages')|e('js') }}'
        };

        var table = $('#datatable-inbox').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '{{ path('dashboard_messages_inbox_list') }}',
                type: 'POST',
                data: function (d) {
                    d.filterUserId = activeFilters.filterUserId;
                    d.filterIsRead = activeFilters.filterIsRead;
                }
            },
            columns: [
                {
                    data: 'isRead',
                    render: function (data, type, row) {
                        var label = data
                            ? '<span class="label label-default"><i class="fa fa-envelope-open-o"></i> ' + i18n.read + '</span>'
                            : '<span class="label label-primary"><i class="fa fa-envelope"></i> ' + i18n.new + '</span>';
                        var toggleTitle = data ? i18n.markAsUnread : i18n.markAsRead;
                        var toggleIcon  = data ? 'fa-envelope' : 'fa-envelope-open-o';
                        return label + '<br><button class="btn btn-xs btn-link btn-toggle-read" data-id="' + row.id + '" title="' + toggleTitle + '" style="padding:2px 0;"><i class="fa ' + toggleIcon + '"></i> ' + toggleTitle + '</button>';
                    }
                },
                {
                    data: null,
                    render: function (row) {
                        return (row.fromUserName || '') + ' ' + (row.fromUserLastName || '');
                    }
                },
                {
                    data: 'subject',
                    render: function (data) {
                        return data ? data : '<span class="text-muted">' + i18n.noSubject + '</span>';
                    }
                },
                {
                    data: 'message',
                    render: function (data) {
                        return data ? data.substring(0, 100) + (data.length > 100 ? '...' : '') : '';
                    }
                },
                { data: 'createdAt' },
                {
                    data: 'id',
                    orderable: false,
                    render: function (id) {
                        return '<a href="{{ path('dashboard_messages') }}/' + id + '" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> ' + i18n.view + '</a>';
                    }
                }
            ],
            order: [[0, 'asc'], [4, 'desc']],
            language: {
                lengthMenu: "{{ 'datatable.lengthMenu'|trans({}, 'dashboard') }}",
                zeroRecords: "{{ 'datatable.zeroRecords'|trans({}, 'dashboard') }}",
                info: "{{ 'datatable.info'|trans({}, 'dashboard') }}",
                infoEmpty: "{{ 'datatable.infoEmpty'|trans({}, 'dashboard') }}",
                emptyTable: "{{ 'datatable.emptyTable'|trans({}, 'dashboard') }}",
                loadingRecords: "{{ 'datatable.loadingRecords'|trans({}, 'dashboard') }}",
                processing: "{{ 'datatable.processing'|trans({}, 'dashboard') }}",
                search: "{{ 'datatable.search'|trans({}, 'dashboard') }}",
                infoFiltered: "{{ 'datatable.infoFiltered'|trans({}, 'dashboard') }}",
                paginate: {
                    next: "{{ 'datatable.paginate.next'|trans({}, 'dashboard') }}",
                    previous: "{{ 'datatable.paginate.previous'|trans({}, 'dashboard') }}"
                }
            }
        });

        $('#btnApplyFilter').on('click', function () {
            activeFilters.filterUserId = $('#filterUserId').val();
            activeFilters.filterIsRead = $('#filterIsRead').val();
            table.ajax.reload();
        });

        $('#btnClearFilter').on('click', function () {
            $('#filterUserId').val('');
            $('#filterIsRead').val('');
            activeFilters.filterUserId = '';
            activeFilters.filterIsRead = '';
            table.ajax.reload();
        });

        $('#datatable-inbox').on('click', '.btn-toggle-read', function () {
            var btn = $(this);
            var id  = btn.data('id');
            btn.prop('disabled', true);
            $.ajax({
                url: '{{ path('dashboard_messages') }}/' + id + '/mark-read',
                type: 'POST',
                success: function (data) {
                    if (data.success) {
                        table.ajax.reload(null, false);
                    }
                },
                complete: function () { btn.prop('disabled', false); }
            });
        });

        $('#btnNewMessageInbox').on('click', function () {
            document.getElementById('fabMessageBtn').click();
        });
    });
    </script>
{% endblock %}
