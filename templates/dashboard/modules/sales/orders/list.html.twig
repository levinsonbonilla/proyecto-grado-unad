{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/data_table/data_table_sales_orders.html.twig' as data_table_extra %}
{% import 'macros/data_table_configuration.html.twig' as data_table %}
{% import 'macros/alert.html.twig' as alert %}

{% block title %}{{ 'sales'|trans({}, 'dashboard') }}{% endblock %}

{% block body %}
    <div class="right_col" role="main">
        <div class="">
            <div class="page-title">
                {{ alert.alert_success() }}
                {{ alert.alert_error() }}
                <div class="title_left">
                    <h3><i class="fa fa-shopping-cart"></i> {{ 'sales'|trans({}, 'dashboard') }}</h3>
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="row" id="salesKpiContainer" style="margin-bottom:16px;">
                <div class="col-md-3 col-sm-6">
                    <div class="x_panel" style="text-align:center;">
                        <div class="x_content">
                            <p style="margin:4px 0; color:#888;">{{ 'kpi_total_sales'|trans({}, 'sales') }}</p>
                            <h2 id="kpiTotalVentas" style="margin:0; font-size:1.8rem;">—</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="x_panel" style="text-align:center;">
                        <div class="x_content">
                            <p style="margin:4px 0; color:#888;">{{ 'kpi_pending_payment'|trans({}, 'sales') }}</p>
                            <h2 id="kpiPendientesPago" style="margin:0; font-size:1.8rem;">—</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="x_panel" style="text-align:center;">
                        <div class="x_content">
                            <p style="margin:4px 0; color:#888;">{{ 'kpi_pending_shipment'|trans({}, 'sales') }}</p>
                            <h2 id="kpiPorEnviar" style="margin:0; font-size:1.8rem;">—</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="x_panel" style="text-align:center;">
                        <div class="x_content">
                            <p style="margin:4px 0; color:#888;">{{ 'kpi_average_ticket'|trans({}, 'sales') }}</p>
                            <h2 id="kpiTicketPromedio" style="margin:0; font-size:1.8rem;">—</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>{{ 'order_list'|trans({}, 'sales') }}</h2>
                            <ul class="nav navbar-right panel_toolbox">
                                <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                                <li><a href="{{ path('dashboard') }}" class="dropdown"><i class="fa fa-home"></i></a></li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <table id="datatable-sales-orders" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>{{ 'status'|trans({}, 'sales') }}</th>
                                        <th>{{ 'actions'|trans({}, 'messages') }}</th>
                                        <th>{{ 'customer'|trans({}, 'sales') }}</th>
                                        <th>{{ 'email'|trans({}, 'sales') }}</th>
                                        <th>{{ 'total'|trans({}, 'sales') }}</th>
                                        <th>{{ 'purchase_date'|trans({}, 'sales') }}</th>
                                        <th>{{ 'tracking_number'|trans({}, 'sales') }}</th>
                                        <th>{{ 'id'|trans({}, 'messages') }}</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ data_table_extra.data_table_sales_orders() }}
    {{ data_table.data_table_configuration_general("#datatable-sales-orders") }}
    <script>
        fetch("{{ path('dashboard_sales_orders_kpi') }}")
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data) return;

                document.getElementById('kpiTotalVentas').textContent = window.formatCurrencyAmount(data.totalVentas || 0);
                document.getElementById('kpiPendientesPago').textContent = data.pedidosPendientesPago || 0;
                document.getElementById('kpiPorEnviar').textContent = data.pedidosPorEnviar || 0;
                document.getElementById('kpiTicketPromedio').textContent = window.formatCurrencyAmount(data.ticketPromedio || 0);
            })
            .catch(function() {});
    </script>
{% endblock %}
