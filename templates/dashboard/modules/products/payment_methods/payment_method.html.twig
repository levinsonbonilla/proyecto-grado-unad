{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/alert.html.twig' as alert %}

{% set type = isEdit | default(false) ? 'edit' : 'add' %}

{% block title %}{{ (type == 'edit' ? 'edit_payment_method' : 'add_payment_method')|trans({}, 'payment_methods') }}{% endblock %}

{% block body %}
    <div class="right_col" role="main">
        <div class="">
            <div class="page-title">
                {{ alert.alert_success() }}
                {{ alert.alert_error() }}
                <div class="title_left">
                    <h3>{{ (type == 'edit' ? 'edit_payment_method' : 'add_payment_method')|trans({}, 'payment_methods') }}</h3>
                </div>
                <div class="title_right">
                    <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                        <div class="input-group">
                            <a href="{{ path('dashboard_products_payment_methods') }}" class="btn btn-default form-control">
                                <i class="fa fa-arrow-left"></i>&nbsp;&nbsp;{{ 'back'|trans({}, 'messages') }}
                            </a>
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="window.location.href='{{ path('dashboard') }}'">
                                    <i class="fa fa-home"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            {{ include('dashboard/modules/products/payment_methods/_form.html.twig') }}
        </div>
    </div>
{% endblock %}
