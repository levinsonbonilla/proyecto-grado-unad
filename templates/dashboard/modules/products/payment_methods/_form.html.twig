<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>{{ (isEdit|default(false) ? 'edit_payment_method' : 'add_payment_method')|trans({}, 'payment_methods') }}</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                    <li><a href="{{ path('dashboard_products_payment_methods') }}" class="dropdown"><i class="fa fa-arrow-right"></i></a></li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">

                {{ form_start(form, {'attr': {'id': 'payment_method_form', 'class': 'form-horizontal form-label-left'}}) }}

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                        {{ 'name'|trans({}, 'messages') }} <span class="required">*</span>
                    </label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.name, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                        {{ 'payment_provider'|trans({}, 'payment_methods') }} <span class="required">*</span>
                    </label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.provider, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12">
                        {{ 'payment_instructions'|trans({}, 'payment_methods') }}
                    </label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.instructions, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'rows': 3}}) }}
                        <span class="help-block">{{ 'payment_instructions_help'|trans({}, 'payment_methods') }}</span>
                    </div>
                </div>

                {% import 'macros/geo_selection.html.twig' as geo %}
                {{ geo.geo_selector(
                    'payment_methods',
                    allCountries,
                    selectedCountryIds,
                    selectedRegionIds,
                    selectedCityIds,
                    path('dashboard_geo_regions'),
                    path('dashboard_geo_cities'),
                    app.request.locale
                ) }}

                <div class="ln_solid"></div>
                <div class="form-group">
                    <div class="col-md-6 col-md-offset-3">
                        <a href="{{ path('dashboard_products_payment_methods') }}" class="btn btn-primary">{{ 'cancel'|trans({}, 'messages') }}</a>
                        <button type="submit" class="btn btn-success">{{ 'save'|trans({}, 'messages') }}</button>
                    </div>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>
