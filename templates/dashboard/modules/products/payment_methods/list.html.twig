{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/data_table/data_table_payment_methods.html.twig' as data_table_extra %}
{% import 'macros/data_table_configuration.html.twig' as data_table %}
{% import 'macros/alert.html.twig' as alert %}
{% import 'macros/modal_confirm_status.html.twig' as modal_status %}

{% block title %}{{ 'payment_methods'|trans({}, 'dashboard') }}{% endblock %}

{% block body %}
    <div class="right_col" role="main">
        <div class="">
            <div class="page-title">
                {{ alert.alert_success() }}
                {{ alert.alert_error() }}
                <div class="title_left">
                    <h3>{{ 'payment_methods'|trans({}, 'dashboard') }}</h3>
                </div>
                <div class="title_right">
                    <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                        <div class="input-group">
                            <a href="{{ path('dashboard_products_payment_methods_new') }}" class="btn btn-default form-control">
                                <i class="fa fa-plus"></i>&nbsp;&nbsp;{{ 'create_payment_method'|trans({}, 'payment_methods') }}
                            </a>
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="window.location.href='{{ path('dashboard') }}'">
                                    <i class="fa fa-home"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>{{ 'list_payment_methods'|trans({}, 'payment_methods') }}</h2>
                            <ul class="nav navbar-right panel_toolbox">
                                <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
                                <li><a href="{{ path('dashboard') }}" class="dropdown"><i class="fa fa-home"></i></a></li>
                                <li><a href="{{ path('dashboard_products_payment_methods_new') }}" class="dropdown"><i class="fa fa-plus"></i></a></li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <table id="datatable-payment-methods" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>{{ 'active'|trans({}, 'messages') }}</th>
                                        <th>{{ 'actions'|trans({}, 'messages') }}</th>
                                        <th>{{ 'name'|trans({}, 'messages') }}</th>
                                        <th>{{ 'id'|trans({}, 'messages') }}</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ modal_status.confirm_status(
        'paymentMethodStatusModal',
        'change_status_modal_title'|trans({}, 'messages'),
        'change_status_modal_body'|trans({}, 'payment_methods'),
        'change_status_modal_confirm'|trans({}, 'messages'),
        'change_status_error'|trans({}, 'messages'),
        'cancel'|trans({}, 'messages')
    ) }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ data_table_extra.data_table_payment_methods() }}
    {{ data_table.data_table_configuration_general("#datatable-payment-methods") }}
{% endblock %}
