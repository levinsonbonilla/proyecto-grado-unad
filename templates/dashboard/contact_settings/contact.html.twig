{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/register_form_script.html.twig' as registerScript %}
{% import 'macros/alert.html.twig' as alert %}

{% block title %}{{ 'contact'|trans({}, 'dashboard') }}
{% endblock %}

{% block body %}
    <div class="right_col" role="main">
        <div class="">
            <div class="page-title">
                {{ alert.alert_success() }}
                {{ alert.alert_error() }}
                <div class="title_left">
                    <h3>{{ 'contact'|trans({}, 'dashboard') }}</h3>
                </div>

                <div class="title_right">
                    <div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
                        <div class="input-group">
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="window.location.href='{{ path('dashboard') }}'">
                                    <i class="fa fa-home" aria-hidden="true"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>{{ 'info'|trans({}, 'contact_settings') }}</h2>
                            <ul class="nav navbar-right panel_toolbox">
                                <li>
                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                </li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">
                            <p class="text-muted">{{ 'contact_hint'|trans({}, 'contact_settings') }}</p>

                            {{ form_start(form, {'attr': {'id': 'contact_form', 'class': 'form-horizontal form-label-left'}}) }}

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="contact_address">{{ 'address'|trans({}, 'contact_settings') }}</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.address, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'rows': 3, 'maxlength': 500}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="contact_phone">{{ 'phone'|trans({}, 'contact_settings') }}</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.phone, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'maxlength': 50}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="contact_email">{{ 'email'|trans({}, 'contact_settings') }}</label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'maxlength': 255}}) }}
                                </div>
                            </div>

                            <div class="ln_solid"></div>
                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-3">
                                    <button id="send" type="submit" class="btn btn-success">{{ 'submit'|trans() }}</button>
                                </div>
                            </div>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ registerScript.form_script_validations('contact_form') }}
{% endblock %}
