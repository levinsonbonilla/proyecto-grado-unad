{% import 'macros/preview_image.html.twig' as image %}
<div class="row">
    <div class="col-md-12 col-sm-12 col-xs-12">
        <div class="x_panel">
            <div class="x_title">
                <h2>{{ 'info'|trans({}, 'slides') }}</h2>
                <ul class="nav navbar-right panel_toolbox">
                    <li>
                        <a class="collapse-link">
                            <i class="fa fa-chevron-up"></i>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('dashboard') }}" class="dropdown">
                            <i class="fa fa-home" aria-hidden="true"></i>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('dashboard_configurations_slides') }}" class="dropdown">
                            <i class="fa fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
                <div class="clearfix"></div>
            </div>
            <div class="x_content">

                {{ form_start(form, {'attr': {'id': 'add_slide_form', 'class': 'form-horizontal form-label-left', 'enctype': 'multipart/form-data'}}) }}

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="slide_image">
                        {{ 'image'|trans({}, 'slides') }}
                    </label>
                    {{ image.general(form, 'slides', slide.image | default('#')) }}
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="name">{{ 'name'|trans({}, 'slides') }}
                        <span class="required">*</span>
                    </label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.name, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="description">{{ 'description'|trans({}, 'slides') }}</label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.description, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="type">{{ 'type'|trans({}, 'slides') }}</label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.type, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                    </div>
                </div>

                <div class="item form-group">
                    <label class="control-label col-md-3 col-sm-3 col-xs-12" for="position">{{ 'position'|trans({}, 'slides') }}</label>
                    <div class="col-md-6 col-sm-6 col-xs-12">
                        {{ form_widget(form.position, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                    </div>
                </div>

                <div class="ln_solid"></div>
                <div class="form-group">
                    <div class="col-md-6 col-md-offset-3">
                        <a href="{{ path('dashboard_configurations_slides') }}" class="btn btn-primary">{{ 'cancel'|trans() }}</a>
                        <button id="send" type="submit" class="btn btn-success">{{ 'submit'|trans() }}</button>
                    </div>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>
