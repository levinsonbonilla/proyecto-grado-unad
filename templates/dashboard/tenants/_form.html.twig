<div class="row">
	<div class="col-md-12 col-sm-12 col-xs-12">
		<div class="x_panel">
			<div class="x_title">
				<h2>{{ 'info'|trans({}, 'tenants') }}
				</h2>
				<ul class="nav navbar-right panel_toolbox">
					<li>
						<a class="collapse-link">
							<i class="fa fa-chevron-up"></i>
						</a>
					</li>
					<li>
						<a href="{{ path("dashboard") }}" class="dropdown">
							<i class="fa fa-home" aria-hidden="true"></i>
						</a>
					</li>
					<li>
						<a href="{{ path("dashboard_tenants") }}" class="dropdown">
							<i class="fa fa-arrow-right" aria-hidden="true"></i>
						</a>
					</li>
				</ul>
				<div class="clearfix"></div>
			</div>
			<div class="x_content">

				{{ form_start(form, {'attr': {'id': 'add_tenant_form', 'class': 'form-horizontal form-label-left', "method":"POST"}}) }}

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'name'|trans({}, 'tenants') }}">{{ 'name'|trans({}, 'tenants') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.name, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'description'|trans({}, 'tenants') }}">{{ 'description'|trans({}, 'tenants') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.description, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'tax_id'|trans({}, 'tenants') }}">{{ 'tax_id'|trans({}, 'tenants') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.nit, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'phone'|trans({}, 'tenants') }}">{{ 'phone'|trans({}, 'tenants') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.phone, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>
				{% if isEdit | default(false) %}
					<div class="item form-group">
						<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'active'|trans({}, 'users') }}">{{ 'active'|trans({}, 'users') }}
							<span class="required">*</span>
						</label>
						<div class="col-md-6 col-sm-6 col-xs-12">
							{{ form_widget(form.activated, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
						</div>
					</div>
					<div class="item form-group">
						<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'is_principal'|trans({}, 'tenants') }}">{{ 'is_principal'|trans({}, 'tenants') }}
							<span class="required">*</span>
						</label>
						<div class="col-md-6 col-sm-6 col-xs-12">
							{{ form_widget(form.isPrincipal, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
						</div>
					</div>
				{% endif %}
					{{ form_widget(form.prefix) }}
					<div class="ln_solid"></div>
					<div class="form-group">
						<div class="col-md-6 col-md-offset-3">
							<a href="{{ path('dashboard_tenants') }}" class="btn btn-primary">{{ 'cancel'|trans() }}</a>
							<button id="send" type="submit" class="btn btn-success">{{ 'submit'|trans() }}</button>
						</div>
					</div>

					{{ form_end(form) }}

				</div>
			</div>
		</div>
	</div>
