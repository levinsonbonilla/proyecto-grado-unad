<div class="row">
	<div class="col-md-12 col-sm-12 col-xs-12">
		<div class="x_panel">
			<div class="x_title">
				<h2>{{ 'personal_info'|trans({}, 'users') }}
				</h2>
				<ul class="nav navbar-right panel_toolbox">
					<li>
						<a class="collapse-link">
							<i class="fa fa-chevron-up"></i>
						</a>
					</li>
					<li>
						<a href="{{ path("dashboard") }}" class="dropdown">
							<i class="fa fa-home" aria-hidden="true"></i>
						</a>
					</li>
					<li>
						<a href="{{ path("dashboard_users") }}" class="dropdown">
							<i class="fa fa-arrow-right" aria-hidden="true"></i>
						</a>
					</li>
				</ul>
				<div class="clearfix"></div>
			</div>
			<div class="x_content">

				{{ form_start(form, {'attr': {'id': 'add_user_form', 'class': 'form-horizontal form-label-left', "method":"POST"}}) }}

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'name'|trans({}, 'users') }}">{{ 'name'|trans({}, 'users') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.name, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'last_name'|trans({}, 'users') }}">{{ 'last_name'|trans({}, 'users') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.lastName, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>

				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'email'|trans({}, 'users') }}">{{ 'email'|trans({}, 'users') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.email, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>
				{% if isEdit | default(false) %}
					<div class="item form-group">
						<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'email_verified'|trans({}, 'users') }}">{{ 'email_verified'|trans({}, 'users') }}
							<span class="required">*</span>
						</label>
						<div class="col-md-6 col-sm-6 col-xs-12">
							{{ form_widget(form.validatedEmail, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
						</div>
					</div>
					<div class="item form-group">
						<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'active'|trans({}, 'users') }}">{{ 'active'|trans({}, 'users') }}
							<span class="required">*</span>
						</label>
						<div class="col-md-6 col-sm-6 col-xs-12">
							{{ form_widget(form.activated, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
						</div>
					</div>
				{% else %}
					{% if is_granted('ROLE_SUPER_ADMIN') %}
						<div class="item form-group">
							<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'tenant'|trans({}, 'users') }}">{{ 'tenant'|trans({}, 'users') }}
								<span class="required">*</span>
							</label>
							<div class="col-md-6 col-sm-6 col-xs-12">
								{{ form_widget(form.tenant, {'attr': {'class': 'form-control'}}) }}
							</div>
						</div>
					{% endif %}

					{% if is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ADMIN')  %}
						<div class="item form-group">
							<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'domain'|trans({}, 'users') }}">{{ 'domain'|trans({}, 'users') }}
								<span class="required">*</span>
							</label>
							<div class="col-md-6 col-sm-6 col-xs-12">
								{{ form_widget(form.domain, {'attr': {'class': 'form-control'}}) }}
							</div>
						</div>
					{% endif %}
				{% endif %}

				
				<div class="item form-group">
					<label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'roles'|trans({}, 'users') }}">{{ 'roles'|trans({}, 'users') }}
						<span class="required">*</span>
					</label>
					<div class="col-md-6 col-sm-6 col-xs-12">
						{{ form_widget(form.roles, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
					</div>
				</div>

				<div class="ln_solid"></div>
				<div class="form-group">
					<div class="col-md-6 col-md-offset-3">
						<a href="{{ path('dashboard_users') }}" class="btn btn-primary">{{ 'cancel'|trans() }}</a>
						<button id="send" type="submit" class="btn btn-success">{{ 'submit'|trans() }}</button>
					</div>
				</div>

				{{ form_end(form) }}

			</div>
		</div>
	</div>
</div>
