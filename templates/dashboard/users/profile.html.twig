{% extends 'dashboard/base_dashboard.html.twig' %}
{% import 'macros/alert.html.twig' as alert %}
{% import 'macros/preview_image.html.twig' as image %}
{% import 'macros/intl_tel_input.html.twig' as intl %}
{% import 'macros/register_form_script.html.twig' as registerScript %}

{% block title %}{{ ('profile')|trans({}, 'dashboard') }}
{% endblock %}

 {% block body %}
	<!-- page content -->
	<div class="right_col" role="main">
		<div class="">
			<div class="page-title">
				{{ alert.alert_success() }}
				{{ alert.alert_error() }}
				<div class="title_left">
					<h3>{{ ('profile')|trans({}, 'dashboard') }}</h3>
				</div>

				<div class="title_right">
					<div class="col-md-5 col-sm-5 col-xs-12 form-group pull-right top_search">
						<div class="input-group">
							<a href="javascript:void(0);" onclick="history.back();" class="btn btn-default form-control">
                                <i class="fa fa-arrow-left" aria-hidden="true"></i>&nbsp;&nbsp;{{ 'back'|trans({}, 'users') }}
                            </a>
							<span class="input-group-btn">
								<button class="btn btn-default" type="button" onclick="window.location.href='{{ path('dashboard') }}'">
									<i class="fa fa-home" aria-hidden="true"></i>
								</button>
							</span>
						</div>
					</div>
				</div>
			</div>
			<div class="clearfix"></div>
			<div class="row">
                <div class="col-md-12 col-sm-12 col-xs-12">
                    <div class="x_panel">
                        <div class="x_title">
                            <h2>{{ 'personal_info'|trans({}, 'users') }}
                            </h2>
                            <ul class="nav navbar-right panel_toolbox">
                                <li>
                                    <a class="collapse-link">
                                        <i class="fa fa-chevron-up"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ path("dashboard") }}" class="dropdown">
                                        <i class="fa fa-home" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ path("dashboard_users") }}" class="dropdown">
                                        <i class="fa fa-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                        <div class="x_content">

                            {{ form_start(form, {'attr': {'id': 'profile_form', 'class': 'form-horizontal form-label-left', "method":"POST"}}) }}

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="domains_logo">
                                    {{ 'profile_image'|trans({}, 'users') }}
                                </label>
                                {{ image.general(form, "profile", image | default("#")) }}
                            </div>
                            
                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'email'|trans({}, 'users') }}">{{ 'email'|trans({}, 'users') }}
                                    <span class="required">*</span>
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'name'|trans({}, 'users') }}">{{ 'name'|trans({}, 'users') }}
                                    <span class="required">*</span>
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.name, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'last_name'|trans({}, 'users') }}">{{ 'last_name'|trans({}, 'users') }}
                                    <span class="required">*</span>
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'birthday_date'|trans({}, 'users') }}">{{ 'birthday_date'|trans({}, 'users') }}
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.dateOfBirth, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'phone'|trans({}, 'tenants') }}">{{ 'phone'|trans({}, 'tenants') }}
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.phone, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'address'|trans({}, 'users') }}">{{ 'address'|trans({}, 'users') }}
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.address, {'attr': {'class': 'form-control col-md-7 col-xs-12'}}) }}
                                </div>
                            </div>
                            
                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'password_label'|trans({}, 'login') }}">{{ 'password_label'|trans({}, 'login') }}
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.password, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'placeholder': 'password_label'|trans({}, 'login'), 'data-parsley-password-strength': '3', 'data-parsley-trigger': 'change' }}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <label class="control-label col-md-3 col-sm-3 col-xs-12" for="{{ 'confirm_password_label'|trans({}, 'login') }}">{{ 'confirm_password_label'|trans({}, 'login') }}
                                </label>
                                <div class="col-md-6 col-sm-6 col-xs-12">
                                    {{ form_widget(form.confirm_password, {'attr': {'class': 'form-control col-md-7 col-xs-12', 'placeholder': 'confirm_password_label'|trans({}, 'login'), 'data-parsley-password-confirm': '8', 'data-parsley-trigger': 'change' }}) }}
                                </div>
                            </div>

                            <div class="item form-group">
                                <div class="col-md-6 col-md-offset-3">
                                    <div id="password-strength-container"></div>
		                            <div id="password-strength"></div>
                                </div>
                            </div>

                            {{ form_widget(form.prefix) }}

                            <div class="ln_solid"></div>
                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-3">
                                    <button id="send" type="submit" class="btn btn-success">{{ 'submit'|trans() }}</button>
                                </div>
                            </div>

                            {{ form_end(form) }}

                        </div>
                    </div>
                </div>
            </div>


		</div>
	</div>
	<!-- /page content -->
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ intl.form_intl_tel_input("profile_phone", "profile_prefix", "profile_form") }}
	
	{{ registerScript.register_form_script("profile_form", "profile_password") }}
{% endblock %}
